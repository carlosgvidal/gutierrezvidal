{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "limes-canonical-0.1.4",
  "title": "LIMES Canonical 0.1.4",
  "type": "object",
  "$defs": {
    "Claim": {
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "factuality": {
          "enum": [
            "REALIZED",
            "REPORTED",
            "ATTRIBUTED",
            "DENIED",
            "PLANNED",
            "INTENDED",
            "REQUIRED",
            "POSSIBLE",
            "CONDITIONAL",
            "COUNTERFACTUAL",
            "UNRESOLVED"
          ],
          "title": "Factuality",
          "type": "string"
        },
        "modality_markers": {
          "items": {
            "type": "string"
          },
          "title": "Modality Markers",
          "type": "array"
        },
        "negated": {
          "default": false,
          "title": "Negated",
          "type": "boolean"
        },
        "status": {
          "default": "OBSERVED",
          "enum": [
            "OBSERVED",
            "INFERRED",
            "ASSUMED",
            "CONTESTED",
            "UNRESOLVED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "document_id",
        "evidence_id",
        "text",
        "factuality"
      ],
      "title": "Claim",
      "type": "object"
    },
    "CooccurrenceEdge": {
      "properties": {
        "source_entity_id": {
          "title": "Source Entity Id",
          "type": "string"
        },
        "target_entity_id": {
          "title": "Target Entity Id",
          "type": "string"
        },
        "shared_claims": {
          "title": "Shared Claims",
          "type": "integer"
        },
        "shared_documents": {
          "title": "Shared Documents",
          "type": "integer"
        }
      },
      "required": [
        "source_entity_id",
        "target_entity_id",
        "shared_claims",
        "shared_documents"
      ],
      "title": "CooccurrenceEdge",
      "type": "object"
    },
    "CorpusMetrics": {
      "properties": {
        "documents": {
          "title": "Documents",
          "type": "integer"
        },
        "sentences": {
          "title": "Sentences",
          "type": "integer"
        },
        "tokens": {
          "title": "Tokens",
          "type": "integer"
        },
        "unique_tokens": {
          "title": "Unique Tokens",
          "type": "integer"
        },
        "lexical_diversity": {
          "title": "Lexical Diversity",
          "type": "number"
        },
        "entity_candidates": {
          "title": "Entity Candidates",
          "type": "integer"
        },
        "claims": {
          "title": "Claims",
          "type": "integer"
        }
      },
      "required": [
        "documents",
        "sentences",
        "tokens",
        "unique_tokens",
        "lexical_diversity",
        "entity_candidates",
        "claims"
      ],
      "title": "CorpusMetrics",
      "type": "object"
    },
    "Document": {
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "document_id",
        "text"
      ],
      "title": "Document",
      "type": "object"
    },
    "EntityCandidate": {
      "properties": {
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "mentions": {
          "title": "Mentions",
          "type": "integer"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "status": {
          "default": "INFERRED",
          "enum": [
            "OBSERVED",
            "INFERRED",
            "ASSUMED",
            "CONTESTED",
            "UNRESOLVED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "label",
        "mentions"
      ],
      "title": "EntityCandidate",
      "type": "object"
    },
    "Evidence": {
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "sentence_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sentence Index"
        }
      },
      "required": [
        "evidence_id",
        "document_id",
        "text"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "LexicalEvidence": {
      "properties": {
        "dimension": {
          "enum": [
            "SER",
            "ESTAR",
            "DECIR",
            "HACER"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "count": {
          "title": "Count",
          "type": "integer"
        },
        "density": {
          "title": "Density",
          "type": "number"
        },
        "terms": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Terms",
          "type": "object"
        },
        "method": {
          "const": "THEORY_DERIVED_LEXICAL_EVIDENCE",
          "default": "THEORY_DERIVED_LEXICAL_EVIDENCE",
          "title": "Method",
          "type": "string"
        },
        "status": {
          "default": "INFERRED",
          "enum": [
            "OBSERVED",
            "INFERRED",
            "ASSUMED",
            "CONTESTED",
            "UNRESOLVED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "count",
        "density"
      ],
      "title": "LexicalEvidence",
      "type": "object"
    },
    "AnalyzeResult": {
      "properties": {
        "documents": {
          "items": {
            "$ref": "#/$defs/Document"
          },
          "title": "Documents",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Claims",
          "type": "array"
        },
        "entities": {
          "items": {
            "$ref": "#/$defs/EntityCandidate"
          },
          "title": "Entities",
          "type": "array"
        },
        "semantic_evidence": {
          "items": {
            "$ref": "#/$defs/LexicalEvidence"
          },
          "title": "Semantic Evidence",
          "type": "array"
        },
        "cooccurrence": {
          "items": {
            "$ref": "#/$defs/CooccurrenceEdge"
          },
          "title": "Cooccurrence",
          "type": "array"
        },
        "metrics": {
          "$ref": "#/$defs/CorpusMetrics"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "interpretation": {
          "type": "object",
          "title": "Interpretation"
        }
      },
      "required": [
        "documents",
        "evidence",
        "claims",
        "entities",
        "semantic_evidence",
        "cooccurrence",
        "metrics",
        "interpretation"
      ],
      "title": "AnalyzeResult",
      "type": "object"
    },
    "StrategicActor": {
      "properties": {
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        },
        "position": {
          "maximum": 100,
          "minimum": 0,
          "title": "Position",
          "type": "number"
        },
        "capacity": {
          "exclusiveMinimum": 0,
          "title": "Capacity",
          "type": "number"
        },
        "salience": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Salience",
          "type": "number"
        },
        "rigidity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rigidity"
        },
        "alpha": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alpha"
        },
        "uncertainty": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty"
        }
      },
      "required": [
        "actor_id",
        "position",
        "capacity",
        "salience"
      ],
      "title": "StrategicActor",
      "type": "object"
    },
    "StrategicModelInput": {
      "properties": {
        "axis_label": {
          "title": "Axis Label",
          "type": "string"
        },
        "actors": {
          "items": {
            "$ref": "#/$defs/StrategicActor"
          },
          "title": "Actors",
          "type": "array"
        }
      },
      "required": [
        "axis_label",
        "actors"
      ],
      "title": "StrategicModelInput",
      "type": "object"
    },
    "PairResult": {
      "properties": {
        "actor_i": {
          "title": "Actor I",
          "type": "string"
        },
        "actor_j": {
          "title": "Actor J",
          "type": "string"
        },
        "distance": {
          "title": "Distance",
          "type": "number"
        },
        "dominance_index_i_over_j": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dominance Index I Over J"
        },
        "strategic_center": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Strategic Center"
        }
      },
      "required": [
        "actor_i",
        "actor_j",
        "distance",
        "dominance_index_i_over_j",
        "strategic_center"
      ],
      "title": "PairResult",
      "type": "object"
    },
    "StrategicActorResult": {
      "properties": {
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        },
        "normalized_capacity": {
          "title": "Normalized Capacity",
          "type": "number"
        },
        "mobilized_capacity": {
          "title": "Mobilized Capacity",
          "type": "number"
        }
      },
      "required": [
        "actor_id",
        "normalized_capacity",
        "mobilized_capacity"
      ],
      "title": "StrategicActorResult",
      "type": "object"
    },
    "StrategicModelResult": {
      "properties": {
        "axis_label": {
          "title": "Axis Label",
          "type": "string"
        },
        "actors": {
          "items": {
            "$ref": "#/$defs/StrategicActorResult"
          },
          "title": "Actors",
          "type": "array"
        },
        "system_center": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "System Center"
        },
        "concentration": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Concentration"
        },
        "pairs": {
          "items": {
            "$ref": "#/$defs/PairResult"
          },
          "title": "Pairs",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "axis_label",
        "actors",
        "system_center",
        "concentration",
        "pairs"
      ],
      "title": "StrategicModelResult",
      "type": "object"
    },
    "GameInput": {
      "properties": {
        "players": {
          "items": {
            "type": "string"
          },
          "title": "Players",
          "type": "array"
        },
        "actions": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Actions",
          "type": "object"
        },
        "payoffs": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object"
          },
          "title": "Payoffs",
          "type": "object"
        }
      },
      "required": [
        "players",
        "actions",
        "payoffs"
      ],
      "title": "GameInput",
      "type": "object"
    },
    "NashProfile": {
      "properties": {
        "profile": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Profile",
          "type": "object"
        },
        "payoffs": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Payoffs",
          "type": "object"
        }
      },
      "required": [
        "profile",
        "payoffs"
      ],
      "title": "NashProfile",
      "type": "object"
    },
    "GameResult": {
      "properties": {
        "equilibria": {
          "items": {
            "$ref": "#/$defs/NashProfile"
          },
          "title": "Equilibria",
          "type": "array"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "equilibria",
        "valid"
      ],
      "title": "GameResult",
      "type": "object"
    }
  },
  "properties": {
    "analysis": {
      "$ref": "#/$defs/AnalyzeResult"
    },
    "strategyInput": {
      "$ref": "#/$defs/StrategicModelInput"
    },
    "strategyResult": {
      "$ref": "#/$defs/StrategicModelResult"
    },
    "gameInput": {
      "$ref": "#/$defs/GameInput"
    },
    "gameResult": {
      "$ref": "#/$defs/GameResult"
    }
  }
}
